# Copy to .env.local for local development. Never commit actual secrets.
ADMIN_API_KEY=replace-with-at-least-32-random-characters
VAPI_WEBHOOK_SECRET=replace-with-a-different-32-character-secret
# Only the local provisioning script needs the PRIVATE key.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=
# Browser-safe Vapi key, restricted to this site origin and assistant.
VAPI_PUBLIC_KEY=
PUBLIC_BASE_URL=
# Reviewer-facing Railway gateway only; point this at the deployed Worker origin.
UPSTREAM_ORIGIN=
# Assessment uses synthetic information. Enable the final payload in stdout.
LOG_DEMOGRAPHICS=true
