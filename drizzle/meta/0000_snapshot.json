      "checkConstraints": {
        "patient_id_uuid": {
          "name": "patient_id_uuid",
          "value": "length(\"patients\".\"patient_id\") = 36"
        },
        "first_name_length": {
          "name": "first_name_length",
          "value": "length(trim(\"patients\".\"first_name\")) BETWEEN 1 AND 50"
        },
        "last_name_length": {
          "name": "last_name_length",
          "value": "length(trim(\"patients\".\"last_name\")) BETWEEN 1 AND 50"
        },
        "sex_enum": {
          "name": "sex_enum",
          "value": "\"patients\".\"sex\" IN ('Male','Female','Other','Decline to Answer')"
        },
        "phone_format": {
          "name": "phone_format",
          "value": "length(\"patients\".\"phone_number\")=10 AND \"patients\".\"phone_number\" NOT GLOB '*[^0-9]*' AND substr(\"patients\".\"phone_number\",1,1) BETWEEN '2' AND '9' AND substr(\"patients\".\"phone_number\",4,1) BETWEEN '2' AND '9'"
        },
        "dob_format": {
          "name": "dob_format",
          "value": "\"patients\".\"date_of_birth\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND date(\"patients\".\"date_of_birth\",'+0 days') IS NOT NULL AND date(\"patients\".\"date_of_birth\",'+0 days')=\"patients\".\"date_of_birth\""
        },
        "street_length": {
          "name": "street_length",
          "value": "length(trim(\"patients\".\"address_line_1\")) BETWEEN 1 AND 200"
        },
        "city_length": {
          "name": "city_length",
          "value": "length(trim(\"patients\".\"city\")) BETWEEN 1 AND 100"
        },
        "state_enum": {
          "name": "state_enum",
          "value": "\"patients\".\"state\" IN ('AL','AK','AZ','AR','CA','CO','CT','DE','DC','FL','GA','HI','ID','IL','IN','IA','KS','KY','LA','ME','MD','MA','MI','MN','MS','MO','MT','NE','NV','NH','NJ','NM','NY','NC','ND','OH','OK','OR','PA','RI','SC','SD','TN','TX','UT','VT','VA','WA','WV','WI','WY')"
        },
        "zip_format": {
          "name": "zip_format",
          "value": "\"patients\".\"zip_code\" GLOB '[0-9][0-9][0-9][0-9][0-9]' OR \"patients\".\"zip_code\" GLOB '[0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]'"
        },
        "member_id_format": {
          "name": "member_id_format",
          "value": "\"patients\".\"insurance_member_id\" IS NULL OR (length(\"patients\".\"insurance_member_id\") BETWEEN 1 AND 100 AND \"patients\".\"insurance_member_id\" NOT GLOB '*[^A-Za-z0-9]*')"
        },
        "emergency_phone_format": {
          "name": "emergency_phone_format",
          "value": "\"patients\".\"emergency_contact_phone\" IS NULL OR (length(\"patients\".\"emergency_contact_phone\")=10 AND \"patients\".\"emergency_contact_phone\" NOT GLOB '*[^0-9]*')"
        },
        "language_length": {
          "name": "language_length",
          "value": "length(trim(\"patients\".\"preferred_language\")) BETWEEN 1 AND 50"
        }
      }
